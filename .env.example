# Discord Bot Credentials
DISCORD_TOKEN=your_discord_bot_token_here
DISCORD_CLIENT_ID=your_discord_client_id_here
DISCORD_GUILD_ID=your_test_guild_id_optional

# 9router / OpenAI Compatible AI Gateway
ROUTER_BASE_URL=http://localhost:20128/v1
ROUTER_API_KEY=dummy-key
ROUTER_MODEL=discord-ai

# AI Context Configuration
AI_MAX_CONTEXT_MESSAGES=10
AI_MAX_CONTEXT_AGE_MINUTES=30
AI_CLEANUP_CRON="0 * * * *"
AI_CHANNEL_ID=your_ai_chat_channel_id_optional

# DevOps / GitHub Webhook Configuration
PORT=3000
GITHUB_WEBHOOK_SECRET=your_github_webhook_secret_here
GITHUB_DEFAULT_CHANNEL_ID=your_discord_channel_id_for_git_logs

# Database (SQLite)
DATABASE_URL="file:./dev.db"
