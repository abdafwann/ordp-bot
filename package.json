{
  "name": "ordp-bot",
  "version": "1.0.0",
  "description": "Modular Discord bot with 9router AI, GitHub Webhook Tracking, Moderation & Economy",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "deploy-commands": "tsx src/deploy-commands.ts",
    "deploy-commands:global": "tsx src/deploy-commands.ts --global",
    "deploy-commands:clear-guild": "tsx src/deploy-commands.ts --clear-guild",
    "deploy-commands:clear-global": "tsx src/deploy-commands.ts --clear-global",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push"
  },
  "dependencies": {
    "@discordjs/opus": "^0.10.0",
    "@discordjs/voice": "^0.19.2",
    "@prisma/client": "^5.22.0",
    "discord.js": "^14.16.3",
    "dotenv": "^16.4.5",
    "ffmpeg-static": "^5.3.0",
    "libsodium-wrappers": "^0.8.4",
    "node-cron": "^3.0.3",
    "openai": "^4.73.0",
    "play-dl": "^1.9.7",
    "youtube-sr": "^4.3.12",
    "yt-dlp-exec": "^1.0.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/libsodium-wrappers": "^0.7.14",
    "@types/node": "^22.9.0",
    "@types/node-cron": "^3.0.11",
    "prisma": "^5.22.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  }
}
